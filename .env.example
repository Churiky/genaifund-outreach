# X API v2 credentials (your own X Developer App — do not commit real values)
X_BEARER_TOKEN=
X_USER_ACCESS_TOKEN=

# Anthropic API key (for DM drafting) — do not commit real values
ANTHROPIC_API_KEY=

# Database (PostgreSQL free tier recommended online; SQLite fallback locally)
DATABASE_URL=sqlite:///./scribbling.db

# Session secret (change this before deploying)
SESSION_SECRET=change-me-in-production

# Send limits (conservative defaults)
MAX_SENDS_PER_RUN=25
MAX_SENDS_PER_DAY=100
COOLDOWN_SECONDS=90
